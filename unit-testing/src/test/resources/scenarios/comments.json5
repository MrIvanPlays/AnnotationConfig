// --- commented
// Class comment

{
  // The name
  name: "Ivan",
  // Server settings
  server: {
    // ip comment
    ip: "localhost",
    port: 25565,
    limits: {
      // players comment
      players: 20
    }
  },
  // first line
  // second line
  multi: 1,
  items: [
    {
      name: "a",
      amount: 1
    }
  ]
}

// --- same-keys-in-sections
// Class comment

{
  // sectionOne comment
  sectionOne: {
    // foo inside sectionOne
    foo: "bb"
  },
  // sectionTwo comment
  sectionTwo: {
    // foo inside sectionTwo
    foo: "cc"
  },
  // foo outside config object
  foo: "aa"
}

// --- section-class-comment
{
  // Section without its own comment
  section: {
    value: 1
  }
}

// --- similar-keys
{
  // portal comment
  portal: 1,
  port: 2
}

// --- dotted-keys-read
// Test subject config. Can change at any time
{
  message: {
    // The message sending strategy
    type: 'component',
    // The message that will be sent to the player
    text: 'foo bar baz'
  }
}

// --- dotted-keys
// Test subject config. Can change at any time
// Generated by AnnotationConfig

{
  message: {
    // The message that will be sent to the player
    // Bla bla 2nd comment
    text: "this is a message",
    // The message sending strategy with which the message will be sent
    type: "string"
  }
}

