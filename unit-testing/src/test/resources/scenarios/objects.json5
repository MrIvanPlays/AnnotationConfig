// --- data-object
{
  data: {
    foo: 2,
    bar: "baz",
    baz: 69420
  }
}

// --- empty
{}

// --- maps
{
  map: {
    key: "value",
    nested: {
      deep: true
    },
    empty: {},
    list: [
      {},
      {
        x: 1
      }
    ]
  },
  tablesOnly: {
    inner: {
      deeper: {
        value: 2
      }
    }
  }
}

// --- objects
{
  plain: {
    foo: "foo string",
    bar: 1,
    baz: 0.555
  },
  "without-empty-constructor": {
    world: "world",
    x: 20
  }
}

// --- records
{
  spawn: {
    "world-name": "world",
    x: 20,
    y: 2,
    z: 1.5,
    safe: true
  },
  home: {
    "world-name": "nether",
    x: -1,
    y: 64,
    z: 3.0,
    safe: false
  }
}

// --- unusual-keys
{
  "bare_key-1": 1,
  "has space": 2,
  "quo'te": 4,
  table: {
    "dotted.key": {
      x: 1
    }
  }
}

