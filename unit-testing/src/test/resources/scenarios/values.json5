// --- choices
{
  enabled: true,
  mode: "fastmode",
  special: "special"
}

// --- multiline
{
  text: "first line\nsecond line\n",
  tricky: "\"\"\" quotes \\ backslash\r\nend\""
}

// --- numbers
{
  b: 1,
  s: 5,
  integer: -42,
  longValue: 1234567890123,
  max: 9223372036854775807,
  min: -9223372036854775808,
  single: 3.11,
  decimal: 2.5,
  big: 1.0E300,
  exact: 0.12345678901234567890,
  huge: 123456789012345678901234567890
}

// --- special-floats
{
  notANumber: NaN,
  positiveInfinity: Infinity,
  negativeInfinity: -Infinity,
  floatInfinity: Infinity
}

// --- text
{
  plain: "Hello world",
  symbols: "a=b & c<d> 'e' #f :g",
  backslash: "C:\\path\\to",
  apostrophe: "it's",
  quotes: "say \"hi\"",
  newline: "line1\nline2",
  tab: "a\tb",
  control: "bell\u0007",
  unicode: "café ☃",
  empty: "",
  character: "x"
}

// --- untyped-numbers
{
  map: {
    whole: 1,
    decimal: 2.5,
    exact: 0.12345678901234567890,
    big: 123456789012345678901234567890
  },
  objects: [
    1,
    2.5
  ],
  integers: [
    123456789012345678901234567890
  ]
}

