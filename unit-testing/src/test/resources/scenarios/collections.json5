// --- list-of-objects
{
  objects: [
    {
      name: "foo",
      value: true
    },
    {
      name: "bar",
      value: "baz"
    }
  ]
}

// --- maps-with-lists-of-maps
{
  values: {
    entries: [
      {
        foo: 1,
        bar: 2,
        baz: [
          "baba",
          "yaga"
        ]
      },
      {
        foo: 3,
        bar: 4,
        baz: {
          baba: "yaga",
          lorem: "ipsum"
        }
      }
    ]
  }
}

// --- single-field-objects
{
  objects: [
    "foo",
    "bar"
  ]
}

