// --- assertion-flag
{
  c: "z"
}

// --- child-sections
// Subject comment

{
  // This is top section comment
  foo: {
    // Control field comment
    control: "asd",
    // Child section comment
    barSect: {
      // Bar comment
      bar: "aabb"
    }
  }
}

// --- config-objects
// Class comment

{
  // Section comment
  server: {
    // ip comment
    ip: "localhost",
    port: 25565,
    limits: {
      // players comment
      players: 20
    }
  },
  // Server class comment
  second: {
    // ip comment
    ip: "localhost",
    port: 25565,
    limits: {
      // players comment
      players: 20
    }
  },
  // Plain field comment
  name: "Ivan"
}

// --- deep-dotted-keys
{
  a: {
    b: {
      c: {
        d: {
          x: 1,
          y: 2
        }
      }
    }
  }
}

// --- dotted-key-joins-section
{
  name: "Ivan",
  server: {
    // ip comment
    ip: "localhost",
    // players comment
    players: 20
  },
  other: {
    port: 25565
  },
  limits: {
    players: {
      max: 100
    }
  }
}

// --- dotted-keys-and-sections
// Generated using AnnotationConfig

{
  // This is a test comment on top of a section
  bar: {
    baz: {
      // Foo comment
      foo: "bar",
      // Bar comment
      bar: "foo"
    }
  },
  kappa: {
    baz: {
      // Foo comment
      foo: "bar",
      // Bar comment
      bar: "foo"
    }
  },
  // This is a control field
  "control-field": -1
}

// --- dotted-keys
{
  commands: {
    subcommands: {
      help: {
        // Foo comment
        foo: "bar"
      },
      this: {
        // Bar comment
        bar: "aaa",
        // baz
        baz: -1
      }
    }
  }
}

// --- inner-section
{
  a: "y",
  inner: {
    b: "x"
  }
}

// --- missing-section-options
// Comments should also be kept!

{
  // This is test subject comment
  test: {
    foo: "foo",
    bar: "bar"
  }
}

// --- parent-class-section
{
  // parent comment
  // child comment
  section: {
    childValue: 2,
    parentValue: 1
  }
}

