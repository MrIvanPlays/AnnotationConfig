{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Generated using AnnotationConfig v3.1.0",
  "type": "object",
  "properties": {
    "allowOption": {
      "description": "A boolean value, whether to allow stuff",
      "type": "boolean",
      "default": true
    },
    "foo": {
      "description": "This value can only be between 1 and 3 (1 and 3 included)",
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "default": 2
    },
    "bar": {
      "description": "This string cannot be longer than 20 characters (spaces are included)",
      "type": "string",
      "maxLength": 20,
      "default": "This is some string"
    },
    "gamemode": {
      "description": "This can only be one of: survival, creative, adventure\nAn enum field works too; @OneOf keeps the option a plain String",
      "type": "string",
      "enum": [
        "survival",
        "creative",
        "adventure"
      ],
      "default": "survival"
    },
    "permissions": {
      "description": "@OneOf on an element type restricts every element of a list, map or array",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read",
          "write",
          "execute"
        ]
      },
      "default": [
        "read",
        "write"
      ]
    },
    "messages": {
      "description": "All configurable messages",
      "type": "object",
      "properties": {
        "no-permission": {
          "description": "The no permission message",
          "type": "string",
          "default": "You don't have permission to perform this command"
        },
        "no-spamming": {
          "description": "The no spamming message",
          "type": "string",
          "default": "You can't spam this"
        }
      }
    },
    "serialize": {
      "description": "This is also going to be serialized as a config object,\nbut it is much more controllable than @ConfigObject",
      "default": {
        "foo": "foo",
        "bar": 1,
        "baz": 2
      }
    },
    "barxtwo": {
      "description": "This cannot have a negative value",
      "type": "number",
      "minimum": 0.0,
      "default": 0.2
    },
    "foo-list": {
      "description": "AnnotationConfig can also read & write lists",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "This is",
        "a lore",
        "as an example",
        "for list"
      ]
    },
    "bar-list": {
      "description": "Lists can be of all primitive types",
      "type": "array",
      "items": {
        "type": "integer"
      },
      "default": [
        1,
        2,
        3,
        4
      ]
    },
    "foosList": {
      "description": "And of non primitive types, which also include records",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bar": {
            "type": "string"
          },
          "baz": {
            "type": "integer"
          }
        }
      },
      "default": [
        {
          "bar": "baz",
          "baz": 1
        },
        {
          "bar": "lorem",
          "baz": 3
        }
      ]
    },
    "foo-map": {
      "description": "Same for maps, but a map can only be Map<String, Object>\notherwise you will need another object",
      "type": "object",
      "additionalProperties": {},
      "default": {
        "foo": 1,
        "bar": "This is a section value",
        "baz": 3
      }
    },
    "default-serializer-example": {
      "description": "This doesn't have a serializer registered\nso it gets serialized by the default serializer",
      "type": "object",
      "properties": {
        "foo": {
          "type": "string",
          "default": "bar"
        },
        "bar": {
          "type": "integer",
          "default": 1
        },
        "baz": {
          "type": "number",
          "default": 5.6
        }
      }
    },
    "inside": {
      "type": "object",
      "properties": {
        "section": {
          "type": "object",
          "properties": {
            "foo": {
              "description": "You can create sections like this too",
              "type": "string",
              "default": "foo"
            }
          }
        }
      }
    },
    "section-inside-section": {
      "description": "This is a section inside a section example",
      "type": "object",
      "properties": {
        "pp": {
          "type": "object",
          "properties": {
            "baz": {
              "description": "Comments are supported here too!",
              "type": "integer",
              "default": 69420
            },
            "foo": {
              "description": "And here!",
              "type": "number",
              "default": 3.3
            }
          }
        }
      }
    },
    "storage": {
      "description": "The 'type' key chooses the implementation of this section",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "sqlite",
            "mysql"
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "type": {
              "const": "sqlite"
            },
            "file": {
              "description": "The database file",
              "type": "string",
              "default": "data.db"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "mysql"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "rewards": {
      "description": "@Polymorphic on a sealed type applies wherever the type is used, lists included",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "MoneyReward",
              "item"
            ]
          }
        },
        "anyOf": [
          {
            "properties": {
              "kind": {
                "const": "MoneyReward"
              },
              "amount": {
                "type": "integer"
              }
            }
          },
          {
            "properties": {
              "kind": {
                "const": "item"
              },
              "item": {
                "type": "string"
              },
              "count": {
                "type": "integer"
              }
            }
          }
        ]
      },
      "default": [
        {
          "kind": "MoneyReward",
          "amount": 100
        },
        {
          "kind": "item",
          "item": "diamond",
          "count": 3
        }
      ]
    }
  }
}
