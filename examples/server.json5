// Server settings

{
  // The address to bind to
  host: "0.0.0.0",
  // Must be between 1 and 65535
  port: 25565,
  motd: {
    // A dotted key is written as a nested object
    text: "Welcome!"
  },
  "allowed-worlds": [
    "world",
    "world_nether"
  ],
  // Database connection
  database: {
    url: "jdbc:mysql://localhost/server",
    // In seconds
    timeout: 30
  }
}